{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/dydjddur/Shorashim/releases/download/v1.0.0/shorashim-v1.0.0.apk",
      "permanent": false
    },
    {
      "source": "/download/apk",
      "destination": "https://github.com/dydjddur/Shorashim/releases/download/v1.0.0/shorashim-v1.0.0.apk",
      "permanent": false
    },
    {
      "source": "/shorashim.apk",
      "destination": "https://github.com/dydjddur/Shorashim/releases/download/v1.0.0/shorashim-v1.0.0.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/invite/:token",
      "destination": "/"
    },
    {
      "source": "/invite",
      "destination": "/"
    }
  ]
}
